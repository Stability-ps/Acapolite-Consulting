{
  "name": "acapolite-mobile",
  "private": true,
  "version": "0.1.0",
  "scripts": {
    "build:web": "npm --prefix .. run build -- --mode mobile",
    "sync": "npm run build:web && cap sync",
    "add:ios": "cap add ios",
    "add:android": "cap add android",
    "open:ios": "cap open ios",
    "open:android": "cap open android"
  },
  "dependencies": {
    "@capacitor/android": "8.5.2",
    "@capacitor/core": "8.5.2",
    "@capacitor/ios": "8.5.2"
  },
  "devDependencies": {
    "@capacitor/cli": "8.5.2"
  }
}
